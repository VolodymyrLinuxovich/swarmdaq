GEMINI_API_KEY=your_gemini_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_key_here

WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=swarmdaq
WANDB_ENTITY=your_wandb_entity_optional

# Upstash Redis — required for persistent market memory, streams, leaderboards, and price intelligence
# Get from: https://console.upstash.com → your database → REST API tab
# Do not commit .env.local or real tokens.
# If TDIGEST commands are unsupported by your Redis provider, SwarmDAQ falls back to rolling quantiles.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Optional: force execution mode (LIVE | SEEDED_DEMO | FALLBACK)
# SEEDED_DEMO gives a predictable 74→91→85→96 arc for demos
# Default: LIVE when GEMINI_API_KEY is set, FALLBACK otherwise
SWARMDAQ_MODE=SEEDED_DEMO
