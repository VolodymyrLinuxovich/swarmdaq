# ── Worker providers — all three run in every LIVE mission ───────────────────
# OpenAI: CodexAgent (product design, architecture, positioning)
OPENAI_API_KEY=

# Anthropic: ClaudeAgent (critique, pitch, risk analysis, fact-checking)
ANTHROPIC_API_KEY=

# Google / Gemini: GeminiAgent (market research, synthesis, ideation)
# Set all three — different SDKs resolve different names.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# ── W&B Weave — optional, in-memory fallback if missing ──────────────────────
WANDB_API_KEY=
WANDB_PROJECT=swarmdaq
WANDB_ENTITY=

# ── Redis Cloud (node-redis TCP) ──────────────────────────────────────────────
# Use either REDIS_URL (preferred) or individual host/port/password fields.
# If neither is set, SwarmDAQ runs with an in-memory store (no persistence).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=true

# ── Mem0 — optional, agent memory disabled if missing ────────────────────────
MEM0_API_KEY=

# ── Exec mode — optional ─────────────────────────────────────────────────────
# LIVE: real provider calls  |  SEEDED_DEMO: deterministic  |  FALLBACK: no LLM
# Default: LIVE when any provider key is set, FALLBACK otherwise
SWARMDAQ_MODE=SEEDED_DEMO
